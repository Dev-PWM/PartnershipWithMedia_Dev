# Contact form email delivery (https://resend.com)
RESEND_API_KEY=
# Where inquiries are delivered. Comma-separate for several addresses.
CONTACT_TO_EMAIL=
# Sender. Must be on a domain verified in Resend. Until then, leave unset to use
# onboarding@resend.dev, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
