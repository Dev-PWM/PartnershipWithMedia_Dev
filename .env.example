# Contact form email delivery (https://resend.com)
RESEND_API_KEY=
# Optional override. Defaults to devteam@partnershipwithmedia-dev.com.
# Comma-separate for several addresses.
CONTACT_TO_EMAIL=
# Sender. Must be on a domain verified in Resend. Until then, leave unset to use
# onboarding@resend.dev, which only delivers to your own Resend account email.
CONTACT_FROM_EMAIL=
NEXT_PUBLIC_SITE_URL=

# Stripe (https://dashboard.stripe.com/test/apikeys). Use test keys until launch.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the Dashboard.
STRIPE_WEBHOOK_SECRET=
# Set to "true" only after adding a Tax registration in the Dashboard.
STRIPE_AUTOMATIC_TAX=
# Customer portal login link where maintenance subscribers cancel or update their
# card (Dashboard → Settings → Billing → Customer portal). Test and live links differ.
# Unset, the site tells subscribers to email instead.
NEXT_PUBLIC_STRIPE_PORTAL_URL=
